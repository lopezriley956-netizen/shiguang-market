<Slide style={{ width: '1280px', height: '720px', background: '#0B1521', padding: '60px' }}>
  <Box style={{ marginBottom: 20 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>五个常见报错，别慌</Text>
    <Box style={{ width: 64, height: 3, background: '#63A7D4', marginTop: 12 }} />
  </Box>
  <Box style={{ height: 492, flexDirection: 'row', gap: 22 }}>
    <Box style={{ width: 270, background: '#3A5CBC', borderRadius: 14, padding: 28, justifyContent: 'center', gap: 18 }}>
      <FAIcon name='life-ring' style={{ fill: '#FFFFFF', width: 52, height: 52 }} />
      <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.3 }}>报错是常态<br />不是你错了</Text>
      <Text style={{ fontSize: 17, color: '#E3F1F8', lineHeight: 1.6 }}>
        零基础最容易被报错劝退。其实就这几样，看一眼就会。
      </Text>
      <Text style={{ fontSize: 16, color: '#B9D7EC', lineHeight: 1.5 }}>看不懂就把报错截图发群里</Text>
    </Box>
    <Box style={{ flex: 1, justifyContent: 'space-between', gap: 10 }}>
      <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center', background: '#13263B', borderRadius: 10, padding: '12px 18px' }}>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#63A7D4', width: 30 }}>1</Text>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>Please tell me who you are</Text>
          <Text style={{ fontSize: 16, color: '#A9CFE7', marginTop: 3 }}>漏了配置名字邮箱 → 补做那两行 config</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center', background: '#13263B', borderRadius: 10, padding: '12px 18px' }}>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#63A7D4', width: 30 }}>2</Text>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>! [rejected] 上传被拒绝</Text>
          <Text style={{ fontSize: 16, color: '#A9CFE7', marginTop: 3 }}>没先 pull → 先 git pull 再 git push</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center', background: '#13263B', borderRadius: 10, padding: '12px 18px' }}>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#63A7D4', width: 30 }}>3</Text>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>出现 &lt;&lt;&lt;&lt;&lt; HEAD 符号</Text>
          <Text style={{ fontSize: 16, color: '#A9CFE7', marginTop: 3 }}>两人改同一行冲突 → 找组长确认保留哪段</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center', background: '#13263B', borderRadius: 10, padding: '12px 18px' }}>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#63A7D4', width: 30 }}>4</Text>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>密码输不对</Text>
          <Text style={{ fontSize: 16, color: '#A9CFE7', marginTop: 3 }}>GitHub 不用账号密码 → 粘贴组长给的 token</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center', background: '#13263B', borderRadius: 10, padding: '12px 18px' }}>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#63A7D4', width: 30 }}>5</Text>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 17, color: '#FFFFFF', fontWeight: 'bold' }}>迷路了，不知道自己在哪</Text>
          <Text style={{ fontSize: 16, color: '#A9CFE7', marginTop: 3 }}>敲 git status → 看改动状态，红色未打包绿色已打包</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
